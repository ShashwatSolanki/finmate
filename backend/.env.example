# Copy to .env and adjust. Used by FastAPI + SQLAlchemy.
APP_ENV=development
# Special characters in the password must be URL-encoded in the URL (@ -> %40, # -> %23, etc.).
# Port 5433 matches docker-compose.yml (host maps 5433 -> container 5432).
# If you run Postgres on 5432 with these credentials, use localhost:5432 instead.
DATABASE_URL=postgresql+psycopg2://finmate:finmate@localhost:5433/finmate

# JWT signing — use a long random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Google OAuth (required to enable Google sign-in)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email delivery. Mock mode is for isolated tests/development only.
# Production and staging require EMAIL_MOCK_MODE=false plus either SMTP credentials or Resend.
EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@example.com
# For hosts that block SMTP (including Render free web services), use the Resend HTTPS API:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=onboarding@resend.dev  # limited testing; verify a domain for general delivery

# Optional: Alpha Vantage (Investment agent extras)
# ALPHA_VANTAGE_API_KEY=

# Local FinMate LLM (Qwen + LoRA in app/ml/). Requires adapter_model.safetensors in FINMATE_LORA_PATH or a checkpoint-* subfolder.
FINMATE_USE_LLM=true
# FINMATE_LORA_PATH=app/ml/finmate-lora
# FINMATE_MAX_NEW_TOKENS=256

# Tesseract OCR (invoice image/scanned PDF parsing). If tesseract is not on PATH after install:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Test-only switch; mock Google tokens are accepted only when APP_ENV=test.
AUTH_ALLOW_MOCK_GOOGLE=false
EMAIL_MOCK_MODE=true  # Local development only; production/staging validation rejects true

# Required for production; use a shared Redis instance for all API workers.
# AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
